<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<meta name="theme-color" content="#0a0a0f">
<title>My AI</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
  html, body {
    background: #0a0a0f;
    color: #eaeaea;
    font-family: -apple-system, BlinkMacSystemFont, 'Inter', system-ui, sans-serif;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    background: #12121a;
    border-bottom: 1px solid #1f1f2a;
    flex-shrink: 0;
  }
  header .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.5px;
  }
  header .dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: #ff4466;
    box-shadow: 0 0 10px #ff4466;
  }
  header .actions { display: flex; gap: 8px; }
  header button {
    background: transparent;
    border: 1px solid #2a2a35;
    color: #a0a0b0;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 12px;
    cursor: pointer;
    transition: 0.15s;
  }
  header button:hover { border-color: #ff4466; color: #fff; }

  #chat {
    flex: 1;
    overflow-y: auto;
    padding: 20px 16px 100px;
    -webkit-overflow-scrolling: touch;
  }
  .msg {
    max-width: 900px;
    margin: 0 auto 16px;
    padding: 14px 18px;
    border-radius: 12px;
    line-height: 1.65;
    font-size: 15px;
    white-space: pre-wrap;
    word-wrap: break-word;
    overflow-wrap: break-word;
    animation: fade 0.15s ease-out;
  }
  @keyframes fade { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
  .user {
    background: #1c2c4a;
    border-left: 3px solid #4a90e2;
    margin-left: auto;
    max-width: 88%;
  }
  .ai {
    background: #16161f;
    border-left: 3px solid #ff4466;
    max-width: 96%;
  }
  .system-msg {
    background: #1a1a10;
    border-left: 3px solid #e0b040;
    color: #c8b060;
    font-size: 13px;
    max-width: 100%;
    text-align: center;
  }

  #composer {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
    background: rgba(18,18,26,0.95);
    backdrop-filter: blur(10px);
    border-top: 1px solid #1f1f2a;
    display: flex;
    gap: 10px;
    align-items: flex-end;
  }
  #input {
    flex: 1;
    padding: 12px 14px;
    background: #0a0a0f;
    border: 1px solid #2a2a35;
    color: #eaeaea;
    border-radius: 10px;
    font-size: 16px;
    font-family: inherit;
    outline: none;
    resize: none;
    max-height: 140px;
    min-height: 44px;
    line-height: 1.4;
    transition: border-color 0.15s;
  }
  #input:focus { border-color: #ff4466; }
  #send {
    padding: 0 18px;
    height: 44px;
    background: #ff4466;
    color: #fff;
    border: none;
    border-radius: 10px;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    transition: 0.15s;
    flex-shrink: 0;
  }
  #send:hover:not(:disabled) { background: #e63950; }
  #send:disabled { background: #3a2a30; color: #6a5a60; cursor: not-allowed; }

  .typing {
    display: inline-block;
    width: 8px; height: 16px;
    background: #ff4466;
    animation: blink 1s infinite;
    vertical-align: text-bottom;
    margin-left: 2px;
  }
  @keyframes blink { 0%, 50% { opacity: 1; } 51%, 100% { opacity: 0; } }

  #settings {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.75);
    display: none;
    align-items: center; justify-content: center;
    padding: 20px;
    z-index: 100;
  }
  #settings.open { display: flex; }
  .modal {
    background: #12121a;
    border: 1px solid #2a2a35;
    border-radius: 14px;
    padding: 22px;
    width: 100%;
    max-width: 460px;
    max-height: 90vh;
    overflow-y: auto;
  }
  .modal h2 { font-size: 17px; margin-bottom: 18px; color: #ff4466; }
  .modal label {
    display: block;
    font-size: 12px;
    color: #808090;
    margin: 14px 0 6px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .modal input, .modal textarea, .modal select {
    width: 100%;
    padding: 10px 12px;
    background: #0a0a0f;
    border: 1px solid #2a2a35;
    color: #eaeaea;
    border-radius: 8px;
    font-size: 14px;
    font-family: inherit;
    outline: none;
  }
  .modal input:focus, .modal textarea:focus, .modal select:focus { border-color: #ff4466; }
  .modal textarea { resize: vertical; min-height: 70px; }
  .modal .row { display: flex; gap: 10px; margin-top: 20px; }
  .modal .row button {
    flex: 1;
    padding: 12px;
    border-radius: 8px;
    border: none;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    transition: 0.15s;
  }
  .save { background: #ff4466; color: #fff; }
  .save:hover { background: #e63950; }
  .cancel { background: #222230; color: #a0a0b0; }
  .cancel:hover { background: #2a2a3a; }
  .hint { font-size: 11px; color: #505060; margin-top: 6px; line-height: 1.5; }

  ::-webkit-scrollbar { width: 8px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: #2a2a35; border-radius: 4px; }
  ::-webkit-scrollbar-thumb:hover { background: #3a3a45; }
</style>
</head>
<body>

<header>
  <div class="brand"><div class="dot"></div>MY AI</div>
  <div class="actions">
    <button onclick="openSettings()">Settings</button>
    <button onclick="clearChat()">Clear</button>
  </div>
</header>

<div id="chat"></div>

<div id="composer">
  <textarea id="input" placeholder="Ask anything..." rows="1"></textarea>
  <button id="send" onclick="send()">Send</button>
</div>

<div id="settings">
  <div class="modal">
    <h2>Configuration</h2>

    <label>API Endpoint</label>
    <input id="cfg-url" placeholder="https://openrouter.ai/api/v1/chat/completions">
    <div class="hint">Any OpenAI-compatible endpoint. Examples: llama.cpp at http://localhost:8080/v1/chat/completions · OpenRouter · Groq · Together · DeepInfra</div>

    <label>API Key</label>
    <input id="cfg-key" type="password" placeholder="sk-...">
    <div class="hint">Stored locally in your browser only. Never sent anywhere except the endpoint above.</div>

    <label>Model</label>
    <input id="cfg-model" placeholder="cognitivecomputations/dolphin-mixtral-8x7b">
    <div class="hint">Whatever model name your endpoint supports.</div>

    <label>System Prompt</label>
    <textarea id="cfg-system" placeholder="You are a helpful AI assistant."></textarea>
    <div class="hint">Sent with every request. Sets the AI's behavior.</div>

    <label>Temperature</label>
    <input id="cfg-temp" type="number" min="0" max="2" step="0.1" placeholder="0.8">

    <div class="row">
      <button class="cancel" onclick="closeSettings()">Cancel</button>
      <button class="save" onclick="saveSettings()">Save</button>
    </div>
  </div>
</div>

<script>
const DEFAULTS = {
  url: "https://openrouter.ai/api/v1/chat/completions",
  key: "",
  model: "cognitivecomputations/dolphin-mixtral-8x7b",
  system: "You are an uncensored AI assistant. Answer directly, truthfully, and in detail. Do not add disclaimers or moralize.",
  temp: 0.8
};

let cfg = loadCfg();
let history = [];
let busy = false;

function loadCfg() {
  try {
    const raw = localStorage.getItem("ai_cfg");
    return raw ? { ...DEFAULTS, ...JSON.parse(raw) } : { ...DEFAULTS };
  } catch { return { ...DEFAULTS }; }
}
function saveCfgToDisk() { localStorage.setItem("ai_cfg", JSON.stringify(cfg)); }

function openSettings() {
  document.getElementById("cfg-url").value = cfg.url;
  document.getElementById("cfg-key").value = cfg.key;
  document.getElementById("cfg-model").value = cfg.model;
  document.getElementById("cfg-system").value = cfg.system;
  document.getElementById("cfg-temp").value = cfg.temp;
  document.getElementById("settings").classList.add("open");
}
function closeSettings() { document.getElementById("settings").classList.remove("open"); }
function saveSettings() {
  cfg.url = document.getElementById("cfg-url").value.trim();
  cfg.key = document.getElementById("cfg-key").value.trim();
  cfg.model = document.getElementById("cfg-model").value.trim();
  cfg.system = document.getElementById("cfg-system").value.trim();
  cfg.temp = parseFloat(document.getElementById("cfg-temp").value) || 0.8;
  saveCfgToDisk();
  closeSettings();
  addSystem("Settings saved.");
}

const chatEl = document.getElementById("chat");
const inputEl = document.getElementById("input");
const sendBtn = document.getElementById("send");

function addBubble(role, text) {
  const el = document.createElement("div");
  el.className = "msg " + (role === "user" ? "user" : role === "system" ? "system-msg" : "ai");
  el.textContent = text;
  chatEl.appendChild(el);
  scrollBottom();
  return el;
}
function addSystem(text) { return addBubble("system", text); }
function scrollBottom() { chatEl.scrollTop = chatEl.scrollHeight; }

function clearChat() {
  if (history.length && !confirm("Clear conversation?")) return;
  history = [];
  chatEl.innerHTML = "";
  addSystem("New conversation. Ask anything.");
}

inputEl.addEventListener("input", () => {
  inputEl.style.height = "auto";
  inputEl.style.height = Math.min(inputEl.scrollHeight, 140) + "px";
});
inputEl.addEventListener("keydown", (e) => {
  if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); send(); }
});
sendBtn.addEventListener("click", send);

async function send() {
  if (busy) return;
  const text = inputEl.value.trim();
  if (!text) return;

  if (!cfg.url) { addSystem("Set your API endpoint first (Settings)."); openSettings(); return; }

  addBubble("user", text);
  history.push({ role: "user", content: text });

  inputEl.value = "";
  inputEl.style.height = "44px";
  busy = true;
  sendBtn.disabled = true;

  const aiEl = addBubble("ai", "");
  const cursor = document.createElement("span");
  cursor.className = "typing";
  aiEl.appendChild(cursor);

  let full = "";
  try {
    const res = await fetch(cfg.url, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        ...(cfg.key ? { "Authorization": "Bearer " + cfg.key } : {})
      },
      body: JSON.stringify({
        model: cfg.model,
        messages: [{ role: "system", content: cfg.system }, ...history],
        temperature: cfg.temp,
        stream: true
      })
    });

    if (!res.ok) {
      const errText = await res.text();
      cursor.remove();
      aiEl.textContent = `Error ${res.status}: ${errText.slice(0, 400)}`;
      busy = false; sendBtn.disabled = false;
      return;
    }

    const reader = res.body.getReader();
    const decoder = new TextDecoder();
    let buffer = "";

    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      buffer += decoder.decode(value, { stream: true });
      const events = buffer.split("\n\n");
      buffer = events.pop() || "";
      for (const evt of events) {
        for (const line of evt.split("\n")) {
          if (!line.startsWith("data:")) continue;
          const payload = line.slice(5).trim();
          if (payload === "[DONE]") continue;
          try {
            const json = JSON.parse(payload);
            const delta = json.choices?.[0]?.delta?.content || "";
            if (delta) {
              full += delta;
              cursor.remove();
              aiEl.textContent = full;
              aiEl.appendChild(cursor);
              scrollBottom();
            }
          } catch {}
        }
      }
    }

    cursor.remove();
    if (!full) aiEl.textContent = "(empty response)";
    history.push({ role: "assistant", content: full });

  } catch (err) {
    cursor.remove();
    aiEl.textContent = "Connection error: " + err.message;
  }

  busy = false;
  sendBtn.disabled = false;
  inputEl.focus();
}

addSystem("Welcome. Open Settings to set your API endpoint, key, and model. Everything is stored locally in your browser.");
if (!cfg.key && cfg.url.includes("openrouter")) {
  addSystem("Tip: OpenRouter needs an API key. Add it in Settings.");
}
</script>
</body>
</html>
